digraph P2PFlowDiamond {
  graph [
    bgcolor="#071321",
    pad="0.28",
    margin="0",
    rankdir=TB,
    nodesep="0.32",
    ranksep="0.54",
    splines=polyline,
    outputorder=edgesfirst,
    fontname="DejaVu Sans",
    fontcolor="#d8e7f5",
    label="P2PFlow — v2 Diamond Smart-Contract Architecture",
    labelloc=t,
    fontsize=24
  ];
  node [shape=box, style="rounded,filled", fillcolor="#12243b", color="#4f708f", fontcolor="#f4f8ff", fontname="DejaVu Sans", fontsize=10, penwidth=1.35, margin="0.13,0.09"];
  edge [color="#38bdf8", fontcolor="#b9cbe0", fontname="DejaVu Sans", fontsize=8, penwidth=1.55, arrowsize=0.66];

  actors [label="User + merchant wallets\nDiamond owner: bootstrap cut + ownership transfer\n7 mutually exclusive managed roles\nUPGRADER: post-init cuts · DEFAULT_ADMIN: role administration\nOPERATOR · PAUSER · PRICE_UPDATER · ORDER_ASSIGNER · DISPUTE_RESOLVER: bounded actions", fillcolor="#1b2940", color="#f59e0b"];
  protocol [label="@p2pflow/protocol\ncanonical selectors · calls · errors\nevents · manifest · artifact digests", fillcolor="#252543", color="#a78bfa"];

  proxy [label="P2PFlowDiamond\n10 facets · 76 selectors\nfallback → selector lookup → delegatecall\none canonical address", fillcolor="#173648", color="#51d5c5", fontsize=13, penwidth=2.4];

  subgraph cluster_governance {
    label="DIAMOND + GOVERNANCE FACETS";
    color="#42516b";
    fontcolor="#9fb4cd";
    style="rounded,filled";
    fillcolor="#0a182a";
    cut [label="DiamondCutFacet\nadd / replace / remove selectors"];
    loupe [label="DiamondLoupeFacet\nfacet + selector introspection"];
    ownership [label="OwnershipFacet\ncontract owner boundary"];
    access [label="AccessControlFacet\nrole admin + grants + revokes"];
    config [label="ConfigFacet\nselective pause · safety config\nminimum stake + custody totals"];
  }

  subgraph cluster_market {
    label="MARKETPLACE FACETS";
    color="#1c675b";
    fontcolor="#75d7c8";
    style="rounded,filled";
    fillcolor="#091d22";
    pricing [label="PricingFacet\npublish policy-bound rounds\nread active round"];
    merchant [label="MerchantFacet\nregistration · status · stake\nliquidity · channel capacity"];
    assignment [label="AssignmentFacet\nbounded candidates\nassign + expire"];
    order [label="OrderFacet\ncreate BUY/SELL · accept/reject\nfiat sent · confirm · cancel · recover"];
    dispute [label="DisputeFacet\nopen · settle · cancel"];
  }

  subgraph cluster_state {
    label="SHARED V2 STORAGE";
    color="#5d4c78";
    fontcolor="#c5afe1";
    style="rounded,filled";
    fillcolor="#151326";
    appstorage [label="AppStorage\nroles · config · rounds · merchants\nchannels · orders · assignments · disputes", fillcolor="#25213d", color="#a78bfa", penwidth=1.9];
    libdiamond [label="LibDiamond\nselector table + ownership"];
    libaccess [label="LibAccess + LibConfig\nrole/state/pause/deadline checks"];
    libmarket [label="LibPricing + LibEligibility + LibMerchants\nquote validity · cap · capacity"];
    libcustody [label="LibOrders + LibCustody\nescrow/reservation accounting\nSafeERC20 exact-balance movement", color="#4ade80"];
    errors [label="Errors + Modifiers\ncanonical fail-closed reverts"];
  }

  initializer [label="DiamondInitV2 · bootstrap only\nfresh-Diamond delegatecall during cut\nnamespaced storage + roles · starts paused\nnot an installed runtime facet", fillcolor="#312744", color="#a78bfa", style="rounded,dashed,filled"];
  usdc [label="Configured 6-decimal USDC\nrelease manifest target:\n0x036CbD53842c5426634e7929541eC2318f3dCF7e\nescrow / reserve / release", fillcolor="#26351f", color="#4ade80", penwidth=1.9];
  events [label="Canonical public events\nroles · prices · merchants · channels\norders · assignments · disputes", fillcolor="#16352e", color="#4ade80"];
  projection [label="Goldsky mappings\npublic read projection only", fillcolor="#17303a", color="#4ade80"];
  fiat [label="External fiat / UPI rail\nparty attestations only\nno payment value in storage or events", fillcolor="#301f3e", color="#e879f9", style="rounded,dashed,filled"];
  invariants [label="On-chain invariants\nparty + role + state + deadline + quote + assignment checks\nBUY acceptance reserves existing merchant liquidity; completion pays user\nSELL creation escrows user USDC; completion credits merchant liquidity\nwithdrawal is separate · custody finalized exactly once", fillcolor="#3a2028", color="#fb7185"];

  { rank=same; actors; protocol; initializer; fiat; }
  { rank=same; cut; loupe; ownership; access; config; }
  { rank=same; pricing; merchant; assignment; order; dispute; }
  { rank=same; libdiamond; libaccess; libmarket; libcustody; errors; }
  { rank=same; usdc; events; invariants; }

  actors -> protocol [style=invis, weight=30];
  protocol -> initializer [style=invis, weight=30];
  initializer -> fiat [style=invis, weight=30];
  cut -> loupe [style=invis, weight=30];
  loupe -> ownership [style=invis, weight=30];
  ownership -> access [style=invis, weight=30];
  access -> config [style=invis, weight=30];
  pricing -> merchant [style=invis, weight=30];
  merchant -> assignment [style=invis, weight=30];
  assignment -> order [style=invis, weight=30];
  order -> dispute [style=invis, weight=30];
  cut -> pricing [style=invis, weight=60];
  config -> dispute [style=invis, weight=60];
  libdiamond -> libaccess [style=invis, weight=30];
  libaccess -> libmarket [style=invis, weight=30];
  libmarket -> libcustody [style=invis, weight=30];
  libcustody -> errors [style=invis, weight=30];
  usdc -> events [style=invis, weight=30];
  events -> invariants [style=invis, weight=30];

  actors -> proxy [label="wallet / owner / role-gated calldata", color="#f59e0b", penwidth=2.1];
  protocol -> proxy [label="verified selector + argument shape", color="#a78bfa", style=dashed];
  initializer -> proxy [label="fresh bootstrap only", color="#a78bfa", style=dashed];
  proxy -> cut; proxy -> loupe; proxy -> ownership; proxy -> access; proxy -> config;
  proxy -> pricing; proxy -> merchant; proxy -> assignment; proxy -> order; proxy -> dispute;

  cut -> libdiamond; loupe -> libdiamond; ownership -> libdiamond;
  access -> libaccess; config -> libaccess; pricing -> libmarket; merchant -> libmarket; assignment -> libmarket; order -> libcustody; dispute -> libcustody;
  libdiamond -> appstorage; libaccess -> appstorage; libmarket -> appstorage; libcustody -> appstorage; errors -> appstorage [style=dashed];
  libcustody -> usdc [label="SafeERC20 + balance delta", color="#f59e0b", penwidth=2];
  actors -> usdc [label="approve Diamond · exact amount", color="#f59e0b", constraint=false];
  actors -> fiat [label="send / receive off-chain", color="#e879f9", style=dotted, constraint=false];
  fiat -> proxy [label="mark sent / confirm received", color="#e879f9", style=dotted, constraint=false];
  pricing -> events [color="#4ade80"];
  merchant -> events [color="#4ade80"];
  assignment -> events [color="#4ade80"];
  order -> events [color="#4ade80"];
  dispute -> events [color="#4ade80"];
  events -> projection [label="canonical blocks only", color="#4ade80"];
  appstorage -> invariants [color="#fb7185", style=dashed, arrowhead=none];
}
