digraph P2PFlowFinalityRecovery {
  graph [
    bgcolor="#071321",
    pad="0.27",
    margin="0",
    rankdir=TB,
    nodesep="0.75",
    ranksep="0.38",
    splines=polyline,
    outputorder=edgesfirst,
    fontname="DejaVu Sans",
    fontcolor="#d8e7f5",
    label="P2PFlow — Finality, Ambiguity, Reorg, and Recovery Model",
    labelloc=t,
    fontsize=24
  ];
  node [shape=box, style="rounded,filled", fillcolor="#12243b", color="#4f708f", fontcolor="#f4f8ff", fontname="DejaVu Sans", fontsize=9.5, penwidth=1.3, margin="0.12,0.08"];
  edge [color="#38bdf8", fontcolor="#b9cbe0", fontname="DejaVu Sans", fontsize=8, penwidth=1.5, arrowsize=0.64];

  browser_title [label="BROWSER WRITE JOURNAL · EXACT-CAS + WEB LOCKS", fillcolor="#173648", color="#51d5c5", fontsize=12, penwidth=2];
  j1 [label="Arm durable journal\nbefore wallet/API side effect\nstable idempotency identity"];
  j2 [label="Wallet request\nreject ≠ broadcast\nunknown hash remains unresolved", color="#f59e0b"];
  j3 [label="Exact transaction proof\nchain · from · to · value · calldata\nreceipt + canonical block hash"];
  j4 [label="Zero-based finality\nhead ≥ receipt block + 12\nN+11 provisional · N+12 final", fillcolor="#20344b", color="#4ade80"];
  j5 [label="Fresh postcondition proof\nstate/event/party/amount exact\nthen bind or terminal action"];
  j6 [label="Exact-CAS clear\nonly the reconciled record\nplaintext already scrubbed", fillcolor="#163629", color="#4ade80"];
  browser_title -> j1 [style=invis, weight=10];
  j1 -> j2 [color="#f59e0b"];
  j2 -> j3 [label="known hash", color="#38bdf8"];
  j3 -> j4 [color="#4ade80"];
  j4 -> j5 [color="#4ade80"];
  j5 -> j6 [color="#4ade80"];

  browser_fault [label="Tab close · reload · two-tab collision · delayed response\nJournal remains authoritative; metadata-only BroadcastChannel wakeup\nContinue / retry reuses the same identity; stale writers cannot regress or clear", fillcolor="#3a2028", color="#fb7185"];
  j2 -> browser_fault [label="no hash / timeout", color="#fb7185", style=dashed];
  j4 -> browser_fault [label="< 12 or block changed", color="#fb7185", style=dashed];
  browser_fault -> j3 [label="bounded reconcile", color="#fb7185", style=dashed, constraint=false];

  executor_title [label="EXECUTOR CANONICAL PIPELINE · POSTGRESQL DURABILITY", fillcolor="#252543", color="#a78bfa", fontsize=12, penwidth=2];
  e1 [label="WSS notification\nwake hint only"];
  e2 [label="Confirmed HTTP scan\nsafe head = chain head − 12\ncontiguous block lineage"];
  e3 [label="Atomic canonical commit\nblocks + events + cursor\ndeterministic job IDs"];
  e4 [label="Claim under canonical fence\nlease + source CAS\nreentrant nested DB session"];
  e5 [label="Simulate + durable outbox\nrole signer + nonce lane\nbroadcast attempt"];
  e6 [label="Receipt + postcondition\nN+12 canonical proof\ncomplete exactly once", fillcolor="#163629", color="#4ade80"];
  executor_title -> e1 [style=invis, weight=10];
  e1 -> e2 [label="wake", color="#38bdf8"];
  e2 -> e3 [color="#4ade80"];
  e3 -> e4 [color="#4ade80"];
  e4 -> e5 [color="#f59e0b"];
  e5 -> e6 [color="#4ade80"];

  uncertain [label="AMBIGUOUS / UNCERTAIN\nNever assume success and never duplicate\nPersist attempt + nonce + raw-tx evidence\nReconcile receipt and canonical state before retry", fillcolor="#3a2820", color="#f59e0b"];
  shallow [label="SHALLOW REORG\nExclusive canonical fence\nmark old events/jobs ORPHANED\nrollback derived state · replay replacement lineage", fillcolor="#3a2028", color="#fb7185"];
  deep [label="DEEP MISMATCH / UNSAFE PROVIDER\nwrites_disabled = true · readiness false\nall automation writes OFF pending operator review", fillcolor="#481b25", color="#fb7185", penwidth=2];
  idempotency [label="Shared safety result\nStable request hashes · immutable completed replies\nexact party/target/amount checks · no private data in logs/projections\nrestart, duplicate delivery, and lost response converge", fillcolor="#17303a", color="#51d5c5"];
  { rank=same; browser_title; executor_title; }
  { rank=same; j1; e1; }
  { rank=same; j2; e2; }
  { rank=same; j3; e3; }
  { rank=same; j4; e4; }
  { rank=same; j5; e5; }
  { rank=same; j6; e6; }
  { rank=same; browser_fault; uncertain; }
  { rank=same; shallow; deep; }

  browser_title -> executor_title [style=invis, weight=30];
  j1 -> e1 [style=invis, weight=30];
  j2 -> e2 [style=invis, weight=30];
  j3 -> e3 [style=invis, weight=30];
  j4 -> e4 [style=invis, weight=30];
  j5 -> e5 [style=invis, weight=30];
  j6 -> e6 [style=invis, weight=30];

  e5 -> uncertain [label="transport / receipt ambiguity", color="#f59e0b", style=dashed];
  uncertain -> e6 [label="evidence-based reconciliation", color="#f59e0b", style=dashed, constraint=false];
  e2 -> shallow [label="recent hash mismatch", color="#fb7185", style=dashed, constraint=false];
  shallow -> e3 [label="replacement branch", color="#fb7185", style=dashed, constraint=false];
  e2 -> deep [label="mismatch beyond retained history", color="#fb7185", style=dashed];
  j6 -> idempotency [color="#4ade80"];
  e6 -> idempotency [color="#4ade80"];
  browser_fault -> shallow [style=invis];
  uncertain -> deep [style=invis];
  shallow -> idempotency [style=invis];
  deep -> idempotency [style=invis];
}
