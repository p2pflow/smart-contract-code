# Base Sepolia only. Copy to .env for local operator convenience, then source it
# explicitly. The deployment script does not load environment files.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Secret: use only a rotated, funded Base Sepolia deployer. Never commit it.
DEPLOYER_PRIVATE_KEY=

# Seven public role addresses. Every address must be distinct from the deployer
# and from every other role holder.
P2PFLOW_EXECUTOR_ADDR=0xA486891ED5Abd2C3B1bB2a20F36B9456e32c7866

# Explicit initialization policy. The development profile is fixed to the
# six-decimal Base Sepolia mUSDC: 0xa50e77Ae17F290Cfb0E2F29B4F2d9D0071Cb6D63.
P2PFLOW_MIN_MERCHANT_STAKE_USDC_ATOMS=100000000
